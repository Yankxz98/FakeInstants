@page "/categories"
@using fakeinstants.Models
@using fakeinstants.Services
@inject SoundManager SoundManager
@inject NavigationManager NavigationManager
@inject ILogger<Categories> Logger

<PageTitle>FakeInstants - Categorias</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2>Gerenciamento de Categorias</h2>
            <p class="text-muted">Organize seus sons em categorias personalizadas.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>Categorias Existentes</h5>
                </div>
                <div class="card-body">
                    @if (categories == null)
                    {
                        <p>Carregando categorias...</p>
                    }
                    else
                    {
                        <!-- Geral - Todos os sons -->
                        <div class="card mb-3 border-primary">
                            <div class="card-header d-flex justify-content-between align-items-center bg-primary bg-opacity-10">
                                <div>
                                    <h5 class="mb-0">
                                        <i class="fas fa-globe me-2 text-primary"></i>
                                        Geral - Todos os Sons
                                    </h5>
                                    <small class="text-muted">@allSoundsCount som(ns) no total</small>
                                </div>
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleAllSounds()">
                                        <i class="fas fa-@(showAllSounds ? "chevron-up" : "chevron-down") me-1"></i>
                                        @(showAllSounds ? "Ocultar" : "Mostrar") Todos
                                    </button>
                                </div>
                            </div>
                            
                            @if (showAllSounds)
                            {
                                <div class="card-body">
                                    @if (isLoadingAllSounds)
                                    {
                                        <div class="text-center py-3">
                                            <div class="spinner-border spinner-border-sm"></div>
                                            <p class="small text-muted mt-2">Carregando sons...</p>
                                        </div>
                                    }
                                    else if (allSounds.Count == 0)
                                    {
                                        <p class="text-muted mb-0">Nenhum som cadastrado no sistema.</p>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Nome</th>
                                                        <th>Categoria</th>
                                                        <th>Arquivo</th>
                                                        <th>Duração</th>
                                                        <th>Reproduções</th>
                                                        <th>Ações</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var sound in allSounds)
                                                    {
                                                        <tr class="@(string.IsNullOrEmpty(sound.CategoryId) || !categories.Any(c => c.Id == sound.CategoryId) ? "table-warning" : "")">
                                                            <td>
                                                                @sound.DisplayName
                                                                @if (sound.Favorite)
                                                                {
                                                                    <i class="fas fa-star text-warning ms-1"></i>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (string.IsNullOrEmpty(sound.CategoryId) || !categories.Any(c => c.Id == sound.CategoryId))
                                                                {
                                                                    <span class="badge bg-warning text-dark">
                                                                        <i class="fas fa-exclamation-triangle me-1"></i>Sem categoria
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    var cat = categories.FirstOrDefault(c => c.Id == sound.CategoryId);
                                                                    if (cat != null)
                                                                    {
                                                                        <span class="badge" style="background-color: @cat.Color">
                                                                            <i class="@cat.Icon me-1"></i>@cat.Name
                                                                        </span>
                                                                    }
                                                                }
                                                            </td>
                                                            <td><small class="text-muted">@sound.FileName</small></td>
                                                            <td>@sound.DurationFormatted</td>
                                                            <td>@sound.PlayCount</td>
                                                            <td>
                                                                <div class="btn-group btn-group-sm">
                                                                    <button class="btn btn-outline-primary" 
                                                                            @onclick="() => EditSound(sound.Id)"
                                                                            title="Editar">
                                                                        <i class="fas fa-edit"></i>
                                                                    </button>
                                                                    <button class="btn btn-outline-info" 
                                                                            @onclick="() => OpenQuickEditModal(sound)"
                                                                            title="Edição rápida">
                                                                        <i class="fas fa-bolt"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (categories.Count == 0)
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                                <p class="text-muted">Nenhuma categoria criada ainda. Crie sua primeira categoria ao lado.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var category in categories)
                        {
                            <div class="card mb-3">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-0">
                                            <i class="@category.Icon me-2" style="color: @category.Color"></i>
                                            @category.Name
                                        </h5>
                                        <small class="text-muted">@category.SoundCount som(ns)</small>
                                    </div>
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleCategorySounds(category.Id)">
                                            <i class="fas fa-@(expandedCategories.Contains(category.Id) ? "chevron-up" : "chevron-down") me-1"></i>
                                            @(expandedCategories.Contains(category.Id) ? "Ocultar" : "Mostrar") Sons
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditCategory(category)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCategory(category.Id)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                
                                @if (expandedCategories.Contains(category.Id))
                                {
                                    <div class="card-body">
                                        @if (isLoadingSounds)
                                        {
                                            <div class="text-center py-3">
                                                <div class="spinner-border spinner-border-sm"></div>
                                                <p class="small text-muted mt-2">Carregando sons...</p>
                                            </div>
                                        }
                                        else
                                        {
                                            var categorySounds = soundsByCategory.ContainsKey(category.Id) 
                                                ? soundsByCategory[category.Id] 
                                                : new List<Sound>();
                                            
                                            @if (categorySounds.Count == 0)
                                            {
                                                <p class="text-muted mb-0">Nenhum som nesta categoria.</p>
                                            }
                                            else
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover mb-0">
                                                        <thead>
                                                            <tr>
                                                                <th>Nome</th>
                                                                <th>Arquivo</th>
                                                                <th>Duração</th>
                                                                <th>Reproduções</th>
                                                                <th>Ações</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var sound in categorySounds)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        @sound.DisplayName
                                                                        @if (sound.Favorite)
                                                                        {
                                                                            <i class="fas fa-star text-warning ms-1"></i>
                                                                        }
                                                                    </td>
                                                                    <td><small class="text-muted">@sound.FileName</small></td>
                                                                    <td>@sound.DurationFormatted</td>
                                                                    <td>@sound.PlayCount</td>
                                                                    <td>
                                                                        <div class="btn-group btn-group-sm">
                                                                            <button class="btn btn-outline-primary" 
                                                                                    @onclick="() => EditSound(sound.Id)"
                                                                                    title="Editar">
                                                                                <i class="fas fa-edit"></i>
                                                                            </button>
                                                                            <button class="btn btn-outline-info" 
                                                                                    @onclick="() => OpenQuickEditModal(sound)"
                                                                                    title="Edição rápida">
                                                                                <i class="fas fa-bolt"></i>
                                                                            </button>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                     <h5>@(isEditing ? "Editar Categoria" : "Adicionar Nova Categoria")</h5>
                </div>
                <div class="card-body">
                    <EditForm Model="@newCategory" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="categoryName" class="form-label">Nome da Categoria</label>
                            <InputText id="categoryName" class="form-control" @bind-Value="newCategory.Name" />
                        </div>

                        <button type="submit" class="btn btn-success">@(isEditing ? "Salvar" : "Adicionar")</button>
                        @if (isEditing)
                        {
                            <button type="button" class="btn btn-secondary" @onclick="ResetForm">Cancelar</button>
                        }
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Edit Modal -->
@if (showQuickEditModal && editingSound != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edição Rápida: @editingSound.DisplayName</h5>
                    <button type="button" class="btn-close" @onclick="CloseQuickEditModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nome</label>
                        <input type="text" class="form-control" @bind="editingSound.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descrição</label>
                        <textarea class="form-control" rows="2" @bind="editingSound.Description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Categoria</label>
                        <select class="form-select" @bind="editingSound.CategoryId">
                            @foreach (var cat in categories ?? new List<Category>())
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="quickEditFavorite" @bind="editingSound.Favorite" />
                        <label class="form-check-label" for="quickEditFavorite">Favorito</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseQuickEditModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveQuickEdit">
                        @if (isSavingQuickEdit)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Salvar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Category>? categories;
    private Category newCategory = new();
    private bool isEditing = false;
    private HashSet<string> expandedCategories = new();
    private Dictionary<string, List<Sound>> soundsByCategory = new();
    private bool isLoadingSounds = false;
    
    private bool showQuickEditModal = false;
    private Sound? editingSound;
    private bool isSavingQuickEdit = false;

    // Geral - Todos os sons
    private bool showAllSounds = false;
    private bool isLoadingAllSounds = false;
    private List<Sound> allSounds = new();
    private int allSoundsCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadAllSoundsCount();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await SoundManager.GetAllCategoriesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar categorias");
        }
    }

    private async Task LoadAllSoundsCount()
    {
        try
        {
            var sounds = await SoundManager.GetAllSoundsAsync();
            allSoundsCount = sounds.Count;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar contagem de sons");
        }
    }

    private async Task ToggleAllSounds()
    {
        showAllSounds = !showAllSounds;
        
        if (showAllSounds && allSounds.Count == 0)
        {
            await LoadAllSounds();
        }
        
        StateHasChanged();
    }

    private async Task LoadAllSounds()
    {
        try
        {
            isLoadingAllSounds = true;
            StateHasChanged();

            allSounds = await SoundManager.GetAllSoundsAsync();
            allSoundsCount = allSounds.Count;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar todos os sons");
        }
        finally
        {
            isLoadingAllSounds = false;
            StateHasChanged();
        }
    }

    private async Task ToggleCategorySounds(string categoryId)
    {
        if (expandedCategories.Contains(categoryId))
        {
            expandedCategories.Remove(categoryId);
        }
        else
        {
            expandedCategories.Add(categoryId);
            
            if (!soundsByCategory.ContainsKey(categoryId))
            {
                await LoadSoundsForCategory(categoryId);
            }
        }
        StateHasChanged();
    }

    private async Task LoadSoundsForCategory(string categoryId)
    {
        try
        {
            isLoadingSounds = true;
            StateHasChanged();

            var sounds = await SoundManager.GetSoundsByCategoryAsync(categoryId);
            soundsByCategory[categoryId] = sounds;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar sons da categoria {0}", categoryId);
        }
        finally
        {
            isLoadingSounds = false;
            StateHasChanged();
        }
    }

    private void EditSound(string soundId)
    {
        NavigationManager.NavigateTo($"/edit/{soundId}");
    }

    private void OpenQuickEditModal(Sound sound)
    {
        editingSound = new Sound
        {
            Id = sound.Id,
            Name = sound.Name,
            Description = sound.Description,
            CategoryId = sound.CategoryId,
            Favorite = sound.Favorite,
            Tags = new List<string>(sound.Tags),
            FileName = sound.FileName,
            FilePath = sound.FilePath,
            FileSize = sound.FileSize,
            Duration = sound.Duration,
            Format = sound.Format,
            CreatedAt = sound.CreatedAt,
            LastPlayed = sound.LastPlayed,
            PlayCount = sound.PlayCount
        };
        showQuickEditModal = true;
        StateHasChanged();
    }

    private void CloseQuickEditModal()
    {
        showQuickEditModal = false;
        editingSound = null;
        StateHasChanged();
    }

    private async Task SaveQuickEdit()
    {
        if (editingSound == null) return;

        try
        {
            isSavingQuickEdit = true;
            StateHasChanged();

            var success = await SoundManager.UpdateSoundAsync(editingSound);
            
            if (success)
            {
                // Update the sound in the local cache
                foreach (var kvp in soundsByCategory)
                {
                    var sound = kvp.Value.FirstOrDefault(s => s.Id == editingSound.Id);
                    if (sound != null)
                    {
                        sound.Name = editingSound.Name;
                        sound.Description = editingSound.Description;
                        sound.CategoryId = editingSound.CategoryId;
                        sound.Favorite = editingSound.Favorite;
                        break;
                    }
                }

                // If category changed, reload affected categories
                CloseQuickEditModal();
                await LoadCategories();
                
                // Reload expanded categories
                foreach (var catId in expandedCategories.ToList())
                {
                    await LoadSoundsForCategory(catId);
                }

                // Reload all sounds if expanded
                if (showAllSounds)
                {
                    await LoadAllSounds();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao salvar edição rápida");
        }
        finally
        {
            isSavingQuickEdit = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (isEditing)
            {
                await SoundManager.UpdateCategoryAsync(newCategory);
            }
            else
            {
                await SoundManager.AddCategoryAsync(newCategory.Name, newCategory.Description);
            }
            await LoadCategories();
            ResetForm();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao salvar categoria");
        }
    }

    private void EditCategory(Category category)
    {
        newCategory = new Category
        {
            Id = category.Id,
            Name = category.Name,
            Description = category.Description,
            Color = category.Color,
            Icon = category.Icon,
            SoundCount = category.SoundCount
        };
        isEditing = true;
    }

    private async Task DeleteCategory(string categoryId)
    {
        try
        {
            await SoundManager.DeleteCategoryAsync(categoryId);
            expandedCategories.Remove(categoryId);
            soundsByCategory.Remove(categoryId);
            await LoadCategories();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao excluir categoria");
        }
    }
    
    private void ResetForm()
    {
        newCategory = new();
        isEditing = false;
        StateHasChanged();
    }
}

